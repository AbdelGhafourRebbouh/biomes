#include <windows.h>
#include "resource.h"
#include "release_version.h"

IDI_BIOMES ICON "biomes.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,BIOMES_BUILD_NUMBER
 PRODUCTVERSION 1,0,0,BIOMES_BUILD_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "biomes"
            VALUE "FileDescription", "biomes"
            VALUE "FileVersion", BIOMES_RELEASE_VERSION
            VALUE "InternalName", "Biomes"
            VALUE "LegalCopyright", "Copyright (C) 2026 Abdelghafour Rebbouh"
            VALUE "OriginalFilename", "Biomes.exe"
            VALUE "ProductName", "biomes"
            VALUE "ProductVersion", BIOMES_RELEASE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
